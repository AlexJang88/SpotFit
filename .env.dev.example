# Developer workstation only. The endpoints point to the Ubuntu VM on the same LAN.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
WATCH_USE_POLLING=true

POSTGRES_HOST=192.168.0.3
POSTGRES_PORT=5432
POSTGRES_DB=spot_fit
POSTGRES_USER=spot_fit
POSTGRES_PASSWORD=PASTE_THE_SERVER_POSTGRES_PASSWORD_HERE

S3_ENDPOINT_URL=http://192.168.0.3:9000
S3_MODEL_BUCKET=spot-fit-models
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=spot_fit_dev
S3_SECRET_ACCESS_KEY=PASTE_THE_SERVER_DEV_S3_SECRET_HERE

MLFLOW_TRACKING_URI=http://192.168.0.3:5000
