# Local development only. Copy to .env and set your own passwords.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_DB=spot_fit
POSTGRES_USER=spot_fit
POSTGRES_PASSWORD=spot_fit_local_password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
AIRFLOW_BIND_ADDRESS=127.0.0.1
AIRFLOW_PORT=8081
AIRFLOW_ADMIN_USER=spotfit
AIRFLOW_FERNET_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
AIRFLOW_SECRET_KEY=spot_fit_airflow_local_secret_key_change_me
MLFLOW_BIND_ADDRESS=127.0.0.1
MLFLOW_PORT=5000
MLFLOW_ARTIFACT_BUCKET=spot-fit-mlflow
MINIO_ROOT_USER=spot_fit_local
MINIO_ROOT_PASSWORD=spot_fit_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Model storage (Docker network address). Bucket names cannot contain underscores.
S3_ENDPOINT_URL=http://minio:9000
S3_MODEL_BUCKET=spot-fit-models
S3_REGION=us-east-1
# Blank values use this PC's local MINIO_ROOT_* credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional development override for the shared Ubuntu MinIO. Set these locally
# only after creating a restricted service identity on that server.
DEV_S3_ENDPOINT_URL=http://192.168.0.3:9000
DEV_S3_MODEL_BUCKET=spot-fit-models
DEV_S3_ACCESS_KEY_ID=
DEV_S3_SECRET_ACCESS_KEY=
# Enable polling for Docker Desktop bind mounts on Windows/macOS.
WATCH_USE_POLLING=true
