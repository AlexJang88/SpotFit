# Local development only. Copy to .env and set your own passwords.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_DB=spot_fit
POSTGRES_USER=spot_fit
POSTGRES_PASSWORD=spot_fit_local_password
POSTGRES_PORT=5432
MINIO_ROOT_USER=spot_fit_local
MINIO_ROOT_PASSWORD=spot_fit_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Model storage (Docker network address). Bucket names cannot contain underscores.
S3_ENDPOINT_URL=http://minio:9000
S3_MODEL_BUCKET=spot-fit-models
S3_REGION=us-east-1
# Blank values use the local MINIO_ROOT_* credentials above.
# For a shared server, set its HTTPS endpoint and separate service credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Enable polling for Docker Desktop bind mounts on Windows/macOS.
WATCH_USE_POLLING=true
