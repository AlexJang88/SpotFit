# Ubuntu VirtualBox test server. Copy this file to .env.server on the VM.
# Replace this example with the static IPv4 assigned to the Ubuntu VM.
APP_BIND_ADDRESS=192.168.0.3
APP_PORT=8080

POSTGRES_DB=spot_fit
POSTGRES_USER=spot_fit
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_24
POSTGRES_BIND_ADDRESS=192.168.0.3
POSTGRES_PORT=5432

AIRFLOW_BIND_ADDRESS=192.168.0.3
AIRFLOW_PORT=8081
AIRFLOW_ADMIN_USER=spotfit
AIRFLOW_FERNET_KEY=CHANGE_ME_WITH_FERNET_KEY
AIRFLOW_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_KEY
MLFLOW_BIND_ADDRESS=192.168.0.3
MLFLOW_PORT=5000
MLFLOW_ARTIFACT_BUCKET=spot-fit-mlflow

MINIO_ROOT_USER=spot_fit_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_OPENSSL_RAND_HEX_24
MINIO_API_BIND_ADDRESS=192.168.0.3
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Ubuntu containers use minio:9000. LAN clients use the VM address on port 9000.
S3_ENDPOINT_URL=http://minio:9000
S3_MODEL_BUCKET=spot-fit-models
S3_REGION=us-east-1
# Blank values keep server-side app containers on the existing MinIO root credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Separate credentials and bucket for developer PCs; create this identity using
# the admin profile after MinIO is running. Copy only DEV_* values to developer .env.
DEV_S3_ENDPOINT_URL=http://192.168.0.3:9000
DEV_S3_MODEL_BUCKET=spot-fit-models
DEV_S3_ACCESS_KEY_ID=spot_fit_dev
DEV_S3_SECRET_ACCESS_KEY=CHANGE_ME_WITH_A_DIFFERENT_OPENSSL_RAND_HEX_32

# Native Linux bind mounts do not need polling.
WATCH_USE_POLLING=false
