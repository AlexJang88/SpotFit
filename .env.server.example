# Ubuntu VirtualBox test server. Copy this file to .env.server on the VM.
# Replace this example with the static IPv4 assigned to the Ubuntu VM.
APP_BIND_ADDRESS=192.168.0.3
APP_PORT=8080

POSTGRES_DB=spot_fit
POSTGRES_USER=spot_fit
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_24
POSTGRES_BIND_ADDRESS=192.168.0.3
POSTGRES_PORT=5432

MINIO_ROOT_USER=spot_fit_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_OPENSSL_RAND_HEX_24
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Containers access MinIO by its Compose service name.
S3_ENDPOINT_URL=http://minio:9000
S3_MODEL_BUCKET=spot-fit-models
S3_REGION=us-east-1
# Blank values use MINIO_ROOT_* for this initial internal test server.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Native Linux bind mounts do not need polling.
WATCH_USE_POLLING=false
